<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AssistEd"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Grid for Cards -->
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus">

        <!-- Voice Navigation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvVoiceNav"
            style="@style/AccessibleCardButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/card_blue">
            <TextView
                style="@style/AccessibleCardText"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Voice Navigation" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Live Caption Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvLiveCaption"
            style="@style/AccessibleCardButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/card_green">
            <TextView
                style="@style/AccessibleCardText"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Live Caption"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scan Text Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvScanText"
            style="@style/AccessibleCardButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/card_orange">
            <TextView
                style="@style/AccessibleCardText"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Scan Text"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- My Notes Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvMyNotes"
            style="@style/AccessibleCardButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/card_purple">
            <TextView
                style="@style/AccessibleCardText"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="My Notes"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Emergency SOS Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvEmergencySos"
            style="@style/AccessibleCardButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/card_red">
            <TextView
                style="@style/AccessibleCardText"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="SOS Alert"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvSettings"
            style="@style/AccessibleCardButton"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/card_gray">
            <TextView
                style="@style/AccessibleCardText"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Settings"/>
        </com.google.android.material.card.MaterialCardView>
    </GridLayout>

    <!-- Output Text Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/gridLayout"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:text="Output will appear here..." />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
